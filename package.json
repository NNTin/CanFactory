{
  "name": "canfactory",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @canfactory/web",
    "api": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "stl-scad": "tsx tools/stl-to-scad/cli.ts",
    "test:renderer": "tsx tools/test-renderer.ts",
    "check:assembly": "tsx tools/check-assembly.ts",
    "test:restart": "tsx tools/test-restart.ts",
    "contracts:generate": "tsx tools/generate-openapi.ts",
    "contracts:check": "tsx tools/generate-openapi.ts --check",
    "build": "npm run typecheck && npm run build --workspace @canfactory/web",
    "check": "npm run typecheck && npm run lint && npm run contracts:check && npm test",
    "test:storage": "tsx tools/test-storage.ts",
    "maintenance": "tsx tools/maintenance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "better-sqlite3": "13.0.3",
    "clipper-lib": "6.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "lucide-react": "1.47.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "tsx": "4.23.15",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
