HALF = THICKNESS / 2;
HANDLE_ROUND_H = HALF - HANDLE_FACE_Z;

// Stack of slices from z0 to z1 at angles a0..a1 (degrees): each slice is the children offset by grow(angle at its
// middle), placed between z(angle) at its ends. grow and z are function literals of the angle.
module rounded_stack(a0, a1, z, grow, steps = ROUND_STEPS) {
    for (i = [0 : steps - 1]) let (t0 = a0 + (a1 - a0) * i / steps, t1 = a0 + (a1 - a0) * (i + 1) / steps,
                                  za = min(z(t0), z(t1)), zb = max(z(t0), z(t1)))
        translate([0, 0, za]) linear_extrude(zb - za) offset(r = grow((t0 + t1) / 2), $fn = ROUNDNESS / 2) children();
}

// The side plate: each slice of PLATE_LAYERS ([z0, z1, outlines, holes]) is its section between z0 and z1. Every other
// slice is moved by LAYER_JITTER, so that no vertex of one slice lies exactly on an edge of the next (where the walls are
// vertical, neighbouring sections share points and lines; the renderer turned such a meeting into zero-area triangles).
module plate() {
    for (i = [0 : len(PLATE_LAYERS) - 1]) let (layer = PLATE_LAYERS[i])
        translate([LAYER_JITTER[0] * (i % 2), LAYER_JITTER[1] * (i % 2), layer[0]]) linear_extrude(layer[1] - layer[0]) difference() {
            for (outline = layer[2]) polygon(outline);
            for (hole = layer[3]) polygon(hole);
        }
}

// What stands above the plate, up to the mid plane: the rail, the arm under the barrel, and the handle where it runs through the
// upper body (vertical walls; the plate's top outline, 0.1 mm in, carries its edge rounding through).
module upper() {
    translate([0, 0, PLATE_T]) linear_extrude(RAIL_T - PLATE_T) polygon(RAIL);
    translate([0, 0, PLATE_T]) linear_extrude(HALF - PLATE_T) polygon(ARM);
    translate([0, 0, PLATE_T]) linear_extrude(HALF - PLATE_T) intersection() {
        polygon(HANDLE);
        offset(delta = -0.1) for (outline = PLATE_LAYERS[len(PLATE_LAYERS) - 1][2]) polygon(outline);
    }
}

// The oval cross section of the handle and of the barrel's tip above the plate: full outline at the mid plane, rounded
// towards the faces (which are the outline inset by HANDLE_ROUND_W, at HANDLE_FACE_Z, below the plate's top).
module oval() {
    a = HANDLE_ROUND_W;
    b = HANDLE_ROUND_H;
    t0 = acos((HALF - PLATE_T) / b); // where the oval rises out of the plate
    rounded_stack(t0, 90, function (t) HALF - b * cos(t), function (t) -a + a * sin(t), 2 * ROUND_STEPS) children();
}

// The grip pocket above the plate (in the plate, PLATE_LAYERS carry it): POCKET is its outline between the rim fillet
// (from the handle's face) and the floor fillet.
module pocket() {
    r = POCKET_RIM_R;
    f = POCKET_FLOOR_R;
    z0 = HANDLE_FACE_Z;
    zw = POCKET_FLOOR_Z - f;
    t0 = acos((z0 + r - PLATE_T) / r); // where the rim fillet leaves the plate
    rounded_stack(t0, 90, function (t) z0 + r - r * cos(t), function (t) r - r * sin(t)) polygon(POCKET);
    translate([0, 0, z0 + r]) linear_extrude(max(zw - z0 - r, 0) + 0.001) polygon(POCKET);
    rounded_stack(0, 90, function (t) zw + f * sin(t), function (t) -f + f * cos(t), 2 * ROUND_STEPS) polygon(POCKET);
}

module socket() {
    h = PLATE_T + 0.5 - SOCKET_APEX_Z;
    translate([PIVOT[0], PIVOT[1], SOCKET_APEX_Z]) cylinder(h = h, r1 = 0, r2 = h * SOCKET_SLOPE, $fn = ROUNDNESS);
}

module half() {
    difference() {
        union() {
            plate();
            upper();
            oval() polygon(HANDLE);
            oval() polygon(TIP);
        }
        pocket();
        socket();
    }
}

// Stand the flat model up on the barrel's top edge (y = TOP_Y), centred through the thickness.
module print_pose() translate([0, -(THICKNESS + PLUS_HEIGHT) / 2, TOP_Y]) rotate([-90, 0, 0]) children();

// The lowest point of `outline` on the vertical line through x (where it crosses it).
function outline_low(outline, x) = min([for (i = [0 : len(outline) - 1]) let (p = outline[i], q = outline[(i + 1) % len(outline)])
    if ((p[0] - x) * (q[0] - x) <= 0 && p[0] != q[0]) p[1] + (q[1] - p[1]) * (x - p[0]) / (q[0] - p[0])]);

// The grip's section across its bottom at x (z, y), up to `rise` above its lowest point: the handle's oval (as oval() rounds
// it, both halves) and the side plate's slices that reach down there. Convex, as the band round it is.
function grip_section(x, rise) = let (
    low = outline_low(HANDLE, x), a = HANDLE_ROUND_W, b = HANDLE_ROUND_H, t0 = acos((HALF - PLATE_T) / b),
    oval = [for (i = [0 : 4 * ROUND_STEPS]) let (t = t0 + (90 - t0) * i / (4 * ROUND_STEPS)) [HALF - b * cos(t), low + a - a * sin(t)]],
    plates = [for (layer = PLATE_LAYERS) let (y = min([for (outline = layer[2]) outline_low(outline, x)])) if (y < low + rise)
        each [[layer[0], y], [layer[1], y]]],
    side = concat(plates, oval))
    concat(side, [for (i = [len(side) - 1 : -1 : 0]) [THICKNESS - side[i][0], side[i][1]]], [[THICKNESS - side[0][0], low + rise + 2], [side[0][0], low + rise + 2]]);

// The channel round the bottom of the grip: GRIP_GROOVE_DEPTH into its section, GRIP_GROOVE_WIDTH wide, up to GRIP_GROOVE_RISE.
module grip_groove() {
    low = outline_low(HANDLE, GRIP_GROOVE_X);
    section = grip_section(GRIP_GROOVE_X, GRIP_GROOVE_RISE);
    // the section's plane (z, y) turned to x = GRIP_GROOVE_X, then about the grip's lowest point to the band's direction
    translate([GRIP_GROOVE_X, low, 0]) rotate([0, 0, GRIP_GROOVE_TILT]) translate([0, -low, 0]) rotate([0, -90, 0])
        linear_extrude(GRIP_GROOVE_WIDTH, center = true) intersection() {
            difference() { offset(delta = 3) hull() polygon(section); offset(r = -GRIP_GROOVE_DEPTH, $fn = ROUNDNESS / 2) hull() polygon(section); }
            translate([-10, low - 10]) square([THICKNESS + 20, GRIP_GROOVE_RISE + 10]);
        }
}

module frame() {
    difference() {
        union() {
            half();
            translate([0, 0, THICKNESS]) mirror([0, 0, 1]) half();
            translate([0, 0, THICKNESS - 0.1]) linear_extrude(PLUS_HEIGHT + 0.1) difference() { polygon(PLUS_OUT); polygon(PLUS_IN); }
        }
        if (RETURN_BAND) grip_groove();
    }
}

