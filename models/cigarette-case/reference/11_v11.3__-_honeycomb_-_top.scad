     [120.6, 36.7], [120.7, 36.4], [121.3, 36.2], [121.3, 30.5], [120.6, 30.3], [120.5, 30], [119.6, 29.7],
     [119.5, 29.4], [118.6, 29.1], [118.5, 28.8], [117.6, 28.5], [117.6, 28.3], [117.1, 28]],
    [[126.8, 28], [126.8, 28.2], [124.8, 29.2], [124, 29.9], [122.5, 30.7], [122.5, 36.1], [124.3, 37],
     [124.4, 37.3], [125, 37.5], [125.1, 37.7], [126.1, 38.1], [126.1, 38.3], [126.7, 38.5], [126.9, 38.8],
     [131.4, 36.1], [131.4, 30.7], [130.8, 30.2], [129.5, 29.6], [129.5, 29.4]],
    [[136.9, 28], [132.6, 30.6], [132.6, 36.1], [135.2, 37.6], [135.4, 37.9], [136, 38.1], [136.8, 38.7],
     [137.1, 38.7], [138.4, 38], [138.9, 37.5], [139.9, 37.1], [140, 36.8], [141.5, 36.1], [141.5, 30.6],
     [140.1, 30], [140, 29.7], [139.2, 29.4], [139.1, 29.2], [138.5, 29], [138.5, 28.8]],
    [[7, 28.1], [5.6, 28.7], [5.5, 29], [2.5, 30.6], [2.5, 36.1], [3.9, 36.8], [4.6, 37.4], [5.4, 37.7], [5.5, 38],
     [6.8, 38.6], [8.2, 38.1], [8.2, 37.9], [9, 37.6], [11.4, 36.1], [11.4, 30.6], [10.5, 30.2], [9.1, 29.2],
     [8.3, 28.9], [8.2, 28.6]]
